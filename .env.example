# ==========================================
# Discord Music Bot Configuration
# ==========================================

# --- Discord Application & Bot Credentials ---
# Required: Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Required: Application / Client ID
DISCORD_CLIENT_ID=
# Optional: Guild ID for instant slash command synchronization (leave empty for global sync)
DISCORD_GUILD_ID=
# Optional: Display name used in embeds, activities, and help menus
DISCORD_APP_NAME=Music Bot
# Optional: HTTP port for health checks on cloud web services (e.g. Render, Koyeb). Auto-set by Render.
PORT=

# --- Bot Command & Identity Defaults ---
COMMAND_PREFIX=!
# Comma-separated list of Discord user IDs allowed to run owner commands (e.g. 123456789,987654321)
OWNER_IDS=
LOG_LEVEL=INFO
# Activity type: listening, playing, watching, competing, streaming
ACTIVITY_TYPE=listening
# Template string (supports {prefix} and {app_name})
ACTIVITY_NAME={prefix}play | {app_name}
# Presence status: online, idle, dnd, invisible
PRESENCE_STATUS=online

# --- YouTube Music API Authentication ---
# Auth modes:
#   "none"   - Unauthenticated mode (default). Search, streaming, and radio autoplay work fine.
#   "oauth"  - Setup with: uv run python -c "from ytmusicapi import setup_oauth; setup_oauth('ID', 'SECRET', filepath='data/oauth.json')"
#   "cookie" - Export browser request headers/cookies to data/headers.json
YTM_AUTH_MODE=none
YTM_AUTH_FILE=data/oauth.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Worker threads for asynchronous ytmusicapi calls
YTM_MAX_WORKERS=4

# --- Audio & Voice Playback Limits ---
DEFAULT_VOLUME=0.5
MIN_VOLUME=0.0
MAX_VOLUME=2.0
MAX_QUEUE_LENGTH=500
# Inactivity timeout in seconds before the bot disconnects from an empty voice channel or idle queue
AUTO_DISCONNECT_TIMEOUT=300
CONNECT_TIMEOUT=20.0
# Optional custom path to libopus library (e.g., /opt/homebrew/lib/libopus.dylib)
DISCORD_OPUS_LIB=

# --- FFmpeg & yt-dlp Streaming Settings ---
FFMPEG_BIN=ffmpeg
FFMPEG_BEFORE_OPTIONS=-reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 5
FFMPEG_OPTIONS=-vn -bufsize 64k
YTDL_FORMAT=bestaudio/best
YTDL_DEFAULT_SEARCH=ytsearch
YTDL_SOCKET_TIMEOUT=15
YTDL_USER_AGENT=
# Client fallback for YouTube extraction (bypasses datacenter bot checks)
YTDL_PLAYER_CLIENTS=android
YTDL_PLAYER_SKIP=configs,webpage
# Optional raw cookies.txt content pasted as environment variable (useful on Render/cloud hosts)
YTDL_COOKIES=
# Optional path to cookies.txt file
YTDL_COOKIES_FILE=
# Optional YouTube Proof of Origin token (PO Token)
YTDL_PO_TOKEN=
# Optional HTTP or SOCKS5 proxy (e.g., http://127.0.0.1:8080 or socks5://user:pass@host:port)
YT_PROXY=

# --- Autoplay & Radio Auto-Suggestions ---
YT_RADIO_ENABLED=true
SUGGESTION_TIMEOUT=30
SEARCH_LIMIT=10

# --- UI Themes, Colors & Customization ---
# Hex color codes (without or with #)
COLOR_PRIMARY=5865F2
COLOR_SUCCESS=57F287
COLOR_WARNING=FEE75C
COLOR_ERROR=ED4245
COLOR_SECONDARY=EB459E
COLOR_QUEUE=5865F2
COLOR_HISTORY=9B59B6
FOOTER_TEXT=
QUEUE_PAGE_SIZE=10
# Interactive button expiration timeout in seconds (or "none" / "0" for no timeout)
BUTTON_TIMEOUT=180
